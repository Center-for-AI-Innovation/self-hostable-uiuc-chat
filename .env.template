# Root .env is the canonical local configuration for this monorepo.
# Docker Compose reads this file directly. Local app processes can source it and
# override Docker-internal service URLs to localhost when running outside Docker.

# =============================================================================
# REQUIRED LOCAL SECRETS
# =============================================================================
POSTGRES_PASSWORD="your-super-secret-and-long-postgres-password" # CHANGE ME
INGEST_REDIS_PASSWORD="your-strong-redis-password"               # CHANGE ME
QDRANT_API_KEY="your-strong-key-here"                            # Must match qdrant_config.yaml
AWS_ACCESS_KEY_ID="minioadmin"                                   # CHANGE ME for non-local use
AWS_SECRET_ACCESS_KEY="minioadmin"                               # CHANGE ME for non-local use
KEYCLOAK_ADMIN_PASSWORD="admin"                                  # CHANGE ME
# Shared by frontend + backend to encrypt/decrypt project_external_connections
# configs. Generate with:
#   python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_MASTER_KEY=""                                         # CHANGE ME

# =============================================================================
# LOCAL RESOURCE NAMES
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_DATABASE=postgres
S3_BUCKET_NAME=uiuc-chat
QDRANT_COLLECTION_NAME=illinois-chat-qwen
AWS_REGION=us-east-1

# =============================================================================
# HOST PORTS
# =============================================================================
FRONTEND_PORT=3000
CRAWLEE_PORT=3345
POSTGRES_PORT=5432
KEYCLOAK_DB_PORT=5433
PUBLIC_MINIO_API_PORT=10000
PUBLIC_MINIO_DASHBOARD_PORT=9001
DOCKER_INTERNAL_MINIO_API_PORT=10000
DOCKER_INTERNAL_MINIO_DASHBOARD_PORT=9001

# Optional Sim local stack. These defaults intentionally avoid the UIUC Chat
# frontend, realtime, and Postgres ports.
SIM_APP_PORT=3010
SIM_REALTIME_PORT=3011
SIM_POSTGRES_PORT=55432
# Sim images are pinned by digest in infra/docker/docker-compose.sim.yaml so an
# upstream release is an upgrade you choose, not one a `docker compose pull`
# performs for you. The access gate in that file patches Sim's own `user` table,
# so an unreviewed Sim upgrade can break — or open — it.
# To move to a newer Sim, resolve the digest and set the matching variable here:
#   docker buildx imagetools inspect ghcr.io/simstudioai/simstudio:latest
# SIM_APP_IMAGE=ghcr.io/simstudioai/simstudio@sha256:...
# SIM_REALTIME_IMAGE=ghcr.io/simstudioai/realtime@sha256:...
# SIM_MIGRATIONS_IMAGE=ghcr.io/simstudioai/migrations@sha256:...
SIM_POSTGRES_USER=postgres
SIM_POSTGRES_PASSWORD=
SIM_POSTGRES_DB=simstudio
# Sim secrets. All four are REQUIRED — the stack refuses to start without them,
# because a working default here would mean every deployment that forgot to
# override it shared one key, and API_ENCRYPTION_KEY is what encrypts the Sim API
# keys at rest. start-dev.sh and start-all.sh generate and persist them on first
# run, so leave these blank unless you are managing secrets yourself.
#
# SIM_API_ENCRYPTION_KEY must be exactly 64 hexadecimal characters:
#   openssl rand -hex 32
# The other three are opaque strings of at least 32 characters:
#   openssl rand -base64 32
SIM_API_ENCRYPTION_KEY=
SIM_BETTER_AUTH_SECRET=
SIM_ENCRYPTION_KEY=
SIM_INTERNAL_API_SECRET=
SIM_NEXT_PUBLIC_APP_URL=http://localhost:3010
SIM_NEXT_PUBLIC_SOCKET_URL=http://localhost:3011
SIM_TRUSTED_ORIGINS=http://localhost:3010,http://localhost:3011,http://keycloak:8080
SIM_API_BASE_URL=http://localhost:3010
# Extra self-hosted Sim origins projects may use as their per-project base URL,
# comma-separated (e.g. https://sim.internal.example.edu). SIM_API_BASE_URL's
# own origin is always trusted; anything not listed here is refused (SSRF guard).
SIM_ALLOWED_SIM_ORIGINS=
SIM_KEYCLOAK_CLIENT_ID=simai
SIM_KEYCLOAK_CLIENT_SECRET=simai-local-secret
SIM_SSO_PROVIDER_ID=uiuc-keycloak
SIM_SSO_DOMAIN=illinois.edu,gmail.com
# This account bypasses Sim's pending-approval gate and becomes a platform
# admin — set it to *your* address. Required; the Sim stack refuses to start
# without it, so it never silently grants admin to someone else's default.
SIM_APPROVAL_ADMIN_EMAIL=

# Local app processes use the host MinIO API endpoint. Do not use the console port.
MINIO_ENDPOINT=http://localhost:10000
MINIO_PUBLIC_ENDPOINT=http://localhost:10000
MINIO_URL=http://localhost:10000

# =============================================================================
# AUTH
# =============================================================================
KEYCLOAK_ADMIN_USERNAME=admin
NEXT_PUBLIC_KEYCLOAK_URL="http://localhost:8080/"
NEXT_PUBLIC_KEYCLOAK_REALM=illinois_chat_realm
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=illinois_chat
NEXT_PUBLIC_USE_ILLINOIS_CHAT_CONFIG=True
NEXT_PUBLIC_SIGNING_KEY=""

# Super admins (comma-separated emails). SUPER_ADMIN_EMAILS drives API-route
# authorization (server-only); the NEXT_PUBLIC_ variant is inlined into the
# client bundle for UI filtering — set both to the same value.
SUPER_ADMIN_EMAILS=
NEXT_PUBLIC_SUPER_ADMIN_EMAILS=

# =============================================================================
# MODEL ENDPOINTS
# =============================================================================
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_API_BASE=http://host.docker.internal:11434/v1
NCSA_HOSTED_API_KEY=
NCSA_HOSTED_VLM_BASE_URL=
# Router model for tool calling on the hosted vLLM (defaults to the NCSA default chat model).
# The vLLM deployment must run with: --enable-auto-tool-choice --tool-call-parser hermes
TOOL_ROUTER_MODEL_ID=
OLLAMA_SERVER_URL=
VLADS_OPENAI_KEY=

# =============================================================================
# OPTIONAL OBSERVABILITY / INTEGRATIONS
# =============================================================================
POSTHOG_API_KEY=not_a_key
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NOMIC_API_KEY=
SENTRY_DSN=
