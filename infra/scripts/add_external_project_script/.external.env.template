# =============================================================================
# external_connections_cli.py configuration — EXAMPLE TEMPLATE
# =============================================================================
# Copy this file to `.external.env` (same directory) and fill in real values:
#
#   cp .external.env.template .external.env
#
# `.external.env` is gitignored — never commit real credentials. Exported
# environment variables take precedence over values in this file.
# Only the sections for the connection kinds you actually use need filling.

# -----------------------------------------------------------------------------
# API access (required)
# -----------------------------------------------------------------------------
# Base URL of the running frontend (Next.js dev server or deployment).
EXT_CONN_BASE_URL=http://localhost:3000

# Super-admin JWT. Log into the frontend as a super admin, then copy the
# `access_token` cookie value (DevTools → Application → Cookies).
ACCESS_TOKEN=

# Default project (course) name — saves typing it on every command.
EXT_PROJECT_NAME=

# -----------------------------------------------------------------------------
# kind: database — external documents + pgvector Postgres
# -----------------------------------------------------------------------------
# Provision the target database FIRST with
# infra/db/provision_external_pgvector_store.sql (see
# docs/external-connections-setup.md). When set without a qdrant config, this
# same database also stores the project's embeddings via pgvector.
#
# Supabase: use the TRANSACTION pooler URI (port 6543), e.g.
#   postgresql://postgres.<ref>:password@<region>.pooler.supabase.com:6543/postgres
# Session mode (port 5432) pins one database session per client connection and
# caps out around 15 sessions, which the app pools can exhaust; direct
# connections (db.<ref>.supabase.co) bypass the pooler entirely.
# Non-transaction Supabase URIs are accepted with a warning.
EXT_DATABASE_CONNECTION_URI=postgresql://user:password@db-host:5432/dbname

# -----------------------------------------------------------------------------
# kind: s3 — external S3 / MinIO object storage
# -----------------------------------------------------------------------------
EXT_S3_ACCESS_KEY_ID=
EXT_S3_SECRET_ACCESS_KEY=
EXT_S3_BUCKET_NAME=
# Set for MinIO / S3-compatible stores (the frontend enables path-style access):
# EXT_S3_ENDPOINT_URL=https://minio.example.edu
# Defaults to us-east-1 when unset:
# EXT_S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# kind: qdrant — external Qdrant vector database (opt-in override)
# -----------------------------------------------------------------------------
# Projects WITHOUT an active qdrant config use pgvector (the default engine).
# The URL's scheme picks http vs https.
# EXT_QDRANT_URL=https://qdrant.example.edu
# EXT_QDRANT_API_KEY=
# Applied only when the URL carries no explicit port:
# EXT_QDRANT_PORT=6333
# The project's primary collection — all ingest writes go there:
# EXT_QDRANT_DEFAULT_COLLECTION=

# -----------------------------------------------------------------------------
# kind: embedding — per-project embedding provider
# -----------------------------------------------------------------------------
# provider must be in the server allow-list (default: openai, ollama).
# EXT_EMBEDDING_PROVIDER=openai
# EXT_EMBEDDING_MODEL=text-embedding-ada-002
# EXT_EMBEDDING_API_KEY=
# EXT_EMBEDDING_API_BASE=https://api.openai.com/v1
# Required when provider=ollama (LangChain /api/embeddings shape):
# EXT_EMBEDDING_BASE_URL=http://ollama.example.edu:11434
# Qwen models only:
# EXT_EMBEDDING_QUERY_INSTRUCTION=
