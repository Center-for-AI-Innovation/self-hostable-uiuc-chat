{
  "name": "uiuc-chat-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "build": "node scripts/update-keycloak-urls.js && next build --webpack",
    "build:self-hosted": "next build --webpack",
    "bd": "infisical run --env=dev -- next build --webpack",
    "dev": "infisical run --env=dev -- next dev --webpack",
    "local": "next dev --webpack",
    "lint": "eslint src __tests__ --ext .js,.jsx,.ts,.tsx --max-warnings=10000",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "typecheck:all": "tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:coverage:check": "npm run test:coverage && node scripts/check-coverage.mjs",
    "test:a11y": "vitest run a11y",
    "test:watch": "vitest --watch",
    "start": "next start",
    "format": "prettier --check --ignore-path .gitignore --ignore-path .prettierignore .",
    "format:fix": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore .",
    "analyze": "cross-env ANALYZE=true next build",
    "db:generate": "npx drizzle-kit generate",
    "db:studio": "npx drizzle-kit studio",
    "db:migrate": "npx drizzle-kit migrate",
    "db:enable-pgvector": "tsx scripts/enable-pgvector.ts",
    "db:push": "npx drizzle-kit push",
    "db:pull": "npx drizzle-kit pull",
    "db:populate": "tsx src/db/custom-functions.ts",
    "shadcn:add": "npx shadcn@latest add"
  },
