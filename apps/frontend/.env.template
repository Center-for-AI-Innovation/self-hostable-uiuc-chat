# Frontend local development env.
# Prefer sourcing the repository-root .env, then override Docker service URLs to localhost.

# App URLs
PORT=3000
RAILWAY_URL=http://localhost:8000
INGEST_URL=http://localhost:8000/ingest
CRAWLEE_API_URL=http://localhost:3345/crawl

# Redis
REDIS_URL=redis://default:your-strong-redis-password@localhost:6379

# Database
POSTGRES_ENDPOINT=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD="your-super-secret-and-long-postgres-password"
POSTGRES_SSL=false

KEYCLOAK_DB_ENDPOINT=localhost
KEYCLOAK_DB_PORT=5433
KEYCLOAK_DB_DATABASE=postgres
KEYCLOAK_DB_USERNAME=postgres
KEYCLOAK_DB_PASSWORD="your-super-secret-and-long-postgres-password"
KEYCLOAK_DB_SSL=false

# MinIO / S3
LOCAL_MINIO=true
AWS_REGION=us-east-1
AWS_KEY=minioadmin
AWS_SECRET=minioadmin
S3_BUCKET_NAME=uiuc-chat
MINIO_ENDPOINT=http://localhost:10000
MINIO_PUBLIC_ENDPOINT=http://localhost:10000
NEXT_PUBLIC_S3_ENDPOINT=http://localhost:10000

# Option 2: SQLite (uncomment to use)
# SQLITE_DB_NAME=uiuc-chat-backend-sqlite.db

# Vector database
# Retrieval engine for /api/getContexts, /api/chat-api/chat, and agent mode.
# - unset or any value other than "qdrant" → frontend Drizzle + pgvector (default)
# - "qdrant" → Python backend /getTopContexts (Qdrant)
# VECTOR_ENGINE=qdrant

QDRANT_COLLECTION_NAME=illinois-chat-qwen
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY="your-strong-key-here"

# Keycloak
KEYCLOAK_URL=http://localhost:8080/
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080/
NEXT_PUBLIC_KEYCLOAK_REALM=illinois_chat_realm
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=illinois_chat
NEXT_PUBLIC_USE_ILLINOIS_CHAT_CONFIG=True
NEXT_PUBLIC_SIGNING_KEY=""

# Hosted/local model endpoints
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_API_BASE=https://embedding.ilchat.mss.illinois.edu/v1
NCSA_HOSTED_API_KEY=
NCSA_HOSTED_VLM_BASE_URL=
OLLAMA_SERVER_URL=
VLADS_OPENAI_KEY=

# Optional
NEXT_PUBLIC_ILLINOIS_CHAT_BANNER_CONTENT=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_API_KEY=not_a_key
