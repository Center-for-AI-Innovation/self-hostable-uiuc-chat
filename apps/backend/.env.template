# Backend/worker local development env.
# Prefer sourcing the repository-root .env, then override Docker service URLs to localhost.

# Database
POSTGRES_ENDPOINT=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD="your-super-secret-and-long-postgres-password"
POSTGRES_SSL=false

# RabbitMQ / Redis
RABBITMQ_URL=amqp://guest:guest@localhost:5672
REDIS_URL=redis://default:your-strong-redis-password@localhost:6379

# Default admins (comma-separated emails) granted to every newly created
# project. Leave empty for no default admins.
DEFAULT_COURSE_ADMINS=

# Vector database — engine is resolved per project by the ConnectionManager
# (pgvector by default; Qdrant only for projects with an active qdrant_config).
QDRANT_COLLECTION_NAME=illinois-chat-qwen
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY="your-strong-key-here"

REFACTORED_MATERIALS_SUPABASE_TABLE=

# MinIO / S3
LOCAL_MINIO=true
MINIO_URL=http://localhost:10000
MINIO_ENDPOINT=http://localhost:10000
MINIO_PUBLIC_ENDPOINT=http://localhost:10000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=uiuc-chat

# Embeddings / hosted models
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_API_BASE=https://embedding.ilchat.mss.illinois.edu/v1
NCSA_HOSTED_API_KEY=
NCSA_HOSTED_VLM_BASE_URL=
OLLAMA_SERVER_URL=
# Comma-separated allow-list (lowercased) for `embedding_config.provider`.
# Enforced by `_resolve_embedding_client`; mirrored on the frontend.
ALLOWED_EMBEDDING_PROVIDERS=openai,ollama
# QWEN_QUERY_INSTRUCTION=    # optional override

# Encryption for project_external_connections configs.
# Must match the frontend's ENCRYPTION_MASTER_KEY.
# Generate with: python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_MASTER_KEY=

# Optional integrations
POSTHOG_API_KEY=not_a_key
NOMIC_API_KEY=
SENTRY_DSN=
SES_HOST=
EMAIL_SENDER=
PASSWORD_SMTP=
SES_PORT=
USERNAME_SMTP=
